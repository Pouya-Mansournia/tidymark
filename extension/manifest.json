{
  "manifest_version": 3,
  "name": "Tidymark — Local Bookmark Organizer",
  "version": "1.2.0",
  "description": "Review local suggestions and organize bookmarks only after approval. No servers, no tracking.",
  "minimum_chrome_version": "120",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_title": "Open Tidymark",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
